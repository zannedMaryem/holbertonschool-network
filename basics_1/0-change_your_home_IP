#!/usr/bin/env bash
# Script to configure custom host resolutions on Ubuntu

HOSTS_FILE="/etc/hosts"

# Check if running as root
if [ "$(id -u)" -ne 0 ]; then
  echo "This script must be run as root (use sudo)."
  exit 1
fi

# Backup the original hosts file
cp $HOSTS_FILE ${HOSTS_FILE}.bak

# Add or update localhost to resolve to 127.0.0.2
sed -i '/localhost/d' $HOSTS_FILE
echo "127.0.0.2   localhost" >> $HOSTS_FILE

# Add or update facebook.com to resolve to 8.8.8.8
sed -i '/facebook.com/d' $HOSTS_FILE
echo "8.8.8.8     facebook.com" >> $HOSTS_FILE

echo "Configuration updated. A backup was saved to ${HOSTS_FILE}.bak"
