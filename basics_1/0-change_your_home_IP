#!/usr/bin/env bash
# Configure localhost and facebook.com resolutions

HOSTS_FILE="/etc/hosts"

if [ "$(id -u)" -ne 0 ]; then
  echo "This script must be run as root (use sudo)."
  exit 1
fi

# Backup
cp $HOSTS_FILE ${HOSTS_FILE}.bak

# Overwrite entries safely
{
  echo "127.0.0.2   localhost"
  echo "8.8.8.8     facebook.com"
} | sudo tee -a $HOSTS_FILE > /dev/null

echo "Configuration updated. A backup was saved to ${HOSTS_FILE}.bak"
